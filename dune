(rule
 (target catala.ncl)
 (deps CATALA-TREE-SITTER-HASH)
 (mode promote)
 (action
  (with-stdin-from
    CATALA-TREE-SITTER-HASH
   (with-stdout-to
     catala.ncl
     (run %{exe:src/gen_ncl.exe})))))

(install
 (section share_root)
 (files
  (emacs/catala-format.el as emacs/site-lisp/catala-format.el)
  (catala.scm as topiary/queries/catala.scm)
  (catala.ncl as topiary/configs/catala.ncl)))
